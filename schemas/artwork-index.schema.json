{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jkingston/trimui-brick-cartridge-assets/schemas/artwork-index.schema.json",
  "title": "Brick curated artwork index",
  "type": "object",
  "required": ["schema_version", "version", "texture_profile", "models_index", "games", "objects"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "models_index": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "texture_profile": {
      "type": "object",
      "required": ["format", "maximum_dimension", "colour_space"],
      "additionalProperties": false,
      "properties": {
        "format": {"const": "png"},
        "maximum_dimension": {"type": "integer", "minimum": 1},
        "colour_space": {"const": "srgb"}
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform", "title", "aliases", "regions", "model", "surfaces", "hashes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "platform": {"enum": ["nes", "gb", "gbc", "gba", "mastersystem", "gamegear", "megadrive", "snes", "psx", "neogeo", "ngpc"]},
          "title": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "regions": {"type": "array", "items": {"type": "string"}},
          "release_code": {"type": ["string", "null"]},
          "model": {"type": "string", "minLength": 1},
          "surfaces": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "hashes": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "objects": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes", "width", "height", "mime_type", "pack", "offset", "attribution"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "mime_type": {"const": "image/png"},
          "pack": {"type": "string", "pattern": "^artwork-[0-9]{3}\\.pack$"},
          "offset": {"type": "integer", "minimum": 0},
          "attribution": {"type": "object"}
        }
      }
    }
  }
}
