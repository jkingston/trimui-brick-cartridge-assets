{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jkingston/trimui-brick-cartridge-assets/schemas/library.schema.json",
  "title": "Installed Brick artwork library",
  "type": "object",
  "required": ["schema_version", "asset_index_version", "games", "attribution"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "asset_index_version": {"type": ["string", "null"]},
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rom", "platform", "match", "title"],
        "properties": {
          "rom": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "match": {"enum": ["sha256", "sha1", "crc32", "name", "ambiguous", "missing"]},
          "game_id": {"type": "string"},
          "title": {"type": "string"},
          "model": {"type": "string"},
          "surfaces": {"type": "object", "additionalProperties": {"type": "string"}},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "attribution": {"type": "object", "additionalProperties": {"type": "object"}}
  }
}
