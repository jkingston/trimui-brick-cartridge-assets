  "sharing_rules": {
    "exact_components": "Evaluated geometry, UVs, corner normals and material-index arrays matched. Retain each instance transform and material-slot binding.",
    "family": "A family is a reusable design grouping, not proof that every member has an identical whole mesh.",
    "artwork": "Preserve each surface crop, aspect and placement. Shell reuse does not authorize substituting a regional label.",
    "boards": "Same board designation does not make photographs, packages, batteries or ROM identity interchangeable. Opaque scenes without visible full boards have a null board binding.",
    "optimization": "Raw scenes remain authoritative. Reduced geometry/textures and baked relief require visual comparison; exact component sharing alone does not change appearance.",
    "exact_geometry": "Named geometry and corner normals match, but UV arrays can differ. Share position/normal buffers only until UV/material usage is resolved; not a whole glTF-mesh dedup claim."
  },
  "packaging": {
    "tool": "tools/share_assets.py",
    "strategy": "Exact bufferView payload and image byte sharing across portable glTF models",
    "preserves": [
      "accessors",
      "UVs",
      "normals",
      "materials",
      "node transforms"
    ],
    "scope": "Storage reuse only; runtime GPU sharing and draw-call reduction are not implied."
  }
}
